# Add a key to switch from the deterministic simulator to the live OpenAI API.
OPENAI_API_KEY=

OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_MEMORY_REASONING_EFFORT=none
OPENAI_CHAT_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

MEMORY_ALLOW_SENSITIVE=false
# Hard per-user ceiling for active atomic memories. This cannot exceed 100.
MEMORY_MAX_FACTS=100
MEMORY_MAX_OUTPUT_TOKENS=2400
CHAT_MAX_OUTPUT_TOKENS=900

# auto = local simulator without a key, live API with a key
# true = always simulate, false = require a key
OFFLINE_DEMO_MODE=auto
DATABASE_PATH=data/memory-demo.sqlite3
HOST=127.0.0.1
PORT=8010
