# Omlorix Global Configuration
# If you do not have a /.env file, copy this .env.example to /.env
# and keep .env.example in version control.
#
# This file configures the Omlorix server and bundled deployment profiles.
# Production-sensitive values must not ship with placeholder defaults.
# Set the required local secrets before running server actions.
# You should still review and rotate credentials before production use.
#
# Tip: See the project documentation for deployment-specific guidance.


# ---------------------------------------------------------------------
# Required secrets
# ---------------------------------------------------------------------

# Replace with a strong, random secret before deploying to production.
#
# IMPORTANT:
# * Must contain at least 64 UTF-8 bytes (otherwise startup aborts with an error banner)
# * The environment is the only source of truth for this key
# * Changing it and restarting Omlorix signs out every user
JWT_SECRET_KEY=""

# Key used for encrypting sensitive data (e.g. API keys) in the database.
# Must be a valid Fernet key (32 URL-safe base64-encoded bytes).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this key is lost, all encrypted data will be unrecoverable.
ENCRYPTION_KEY=""

# Salt used to create pseudonymous password reset identifier hashes for
# throttling notifications and correlation. This is primarily used for privacy reasons.
# Required for stable hashes across restarts. Generate a unique random value per install.
PASSWORD_RESET_IDENTIFIER_HASH_SALT=""

# Independent salt for pseudonymous audit and password-reset IP fingerprints.
# Keep this stable across restarts and do not reuse JWT_SECRET_KEY.
LOG_IP_HASH_SALT=""


# ---------------------------------------------------------------------
# Optional configuration
# ---------------------------------------------------------------------
# Any `CHANGE_ME` value must be replaced before a production deployment can start.


# ---------------------------------------------------------------------
# Application mode and trust policy
# ---------------------------------------------------------------------
# Possible values: "dev" or "production"
# For dev: Swagger UI, ReDoc, and OpenAPI are enabled. When bundled Postgres
# or Redis are used, their ports are exposed on 127.0.0.1 through
# docker-compose.dev-ports.yml.
# For production: Swagger UI, ReDoc, and OpenAPI are disabled.
MODE="production"

# Keep false unless this deployment intentionally serves Omlorix from a
# localhost, loopback, or a literal private-IP browser address after setup.
# Origin enforcement is disabled while no public URL is configured. Enabling
# this setting permits local/private browser origins for sensitive auth checks
# after a public URL is configured and accepts those literal addresses in Host
# headers; arbitrary DNS names remain untrusted after setup. Before a public
# URL is configured, all Host values and browser origins are accepted.
ALLOW_LOCAL_OR_PRIVATE_ORIGINS=true

# Enable this when Omlorix runs behind a trusted reverse proxy. The launcher can
# configure this automatically from Visitor IPs > Fix automatically.
TRUST_PROXY_HEADERS=false

# The bundled public nginx frontend overwrites incoming X-Forwarded-For by
# default. Enable preservation only when its published port is reachable solely
# through a trusted upstream proxy that overwrites client-supplied forwarding
# headers. The Launcher and CLI manage this automatically for authenticated
# managed ingress; external proxies must use the configured allowlist and
# installation secret described below.
FRONTEND_TRUST_PROXY_HEADERS=false
# Optional comma-separated IP/CIDR allowlist for an external authoritative
# proxy that connects directly to nginx and emits one X-Forwarded-For address.
FRONTEND_TRUSTED_UPSTREAMS=""

# Generated by the Server Launcher or omlorix-server CLI. nginx uses this secret
# only to authenticate the host proxy hop; it is never returned by status or
# verification endpoints. Leave empty only when neither managed nor
# secret-authenticated external ingress is used.
OMLORIX_LAUNCHER_PROXY_SECRET=""

# Emergency break-glass switch for accidental admin lockouts. Set to true only
# long enough to regain access and fix Security > IP restrictions / IP bans.
# Restart the backend/container after changing this .env value.
OMLORIX_DISABLE_IP_RESTRICTIONS=false

# Comma-separated CIDR ranges for reverse proxies that may set X-Forwarded-For.
# Keep this limited to your own proxy/container networks. The Launcher and CLI
# discover and persist the current frontend address when managed ingress is used.
TRUSTED_PROXIES=""

# Comma-separated Host header values accepted by the backend. The PUBLIC_URL and
# configured general.public_url hosts are also trusted automatically.
TRUSTED_HOSTS=""

# Optional app-associated HTTPS origin for native social/SSO authentication.
# Supply only an origin such as https://auth.example.com, without a path,
# query, credentials, or fragment. Leave empty to disable native auth handoff.
OMLORIX_NATIVE_CALLBACK_ORIGIN=""

# Uvicorn access logs also need proxy header trust. Add only known reverse proxy
# IPs/CIDRs here; do not use broad private or Docker network ranges in production.
UVICORN_FORWARDED_ALLOW_IPS="127.0.0.1,::1"


# ---------------------------------------------------------------------
# Release, images, and bundled services
# ---------------------------------------------------------------------

# The Launcher and CLI replace this with a stable per-home project name.
COMPOSE_PROJECT_NAME=""

# Stable random identity used to verify Compose resources before lifecycle work.
OMLORIX_INSTALLATION_ID=""

# Release/launcher deployments use published images. Source-checkout workflows
# build their images directly from the checked-out backend and frontend code.
# Keep this pinned to a reviewed Omlorix release instead of a moving channel tag.
OMLORIX_VERSION=0.9.2

# These toggles control which bundled services start inside Docker Compose.
# REDIS_ENABLED=false also omits Redis-backed worker and exporter services;
# OMLORIX_USE_BUNDLED_REDIS then has no effect until Redis is enabled again.
OMLORIX_USE_BUNDLED_DB=true
OMLORIX_USE_BUNDLED_REDIS=true
REDIS_ENABLED=true
OMLORIX_USE_PGBOUNCER=false
OMLORIX_USE_BUNDLED_STORAGE=false


# ---------------------------------------------------------------------
# Host port bindings
# ---------------------------------------------------------------------
# Change these per checkout when running multiple Omlorix stacks on the same host.
# If you change the dev DB/Redis ports here, also keep the host-facing
# DATABASE_PORT and REDIS_URL values in their respective configuration sections.
# Loopback is the safe default. Set 0.0.0.0 explicitly only for intentional
# direct LAN/public access with an appropriate firewall, trusted-host policy,
# and reverse-proxy/TLS design.
FRONTEND_HTTP_HOST_BIND=127.0.0.1
FRONTEND_HTTP_HOST_PORT=8080
DEV_DATABASE_HOST_PORT=5432
DEV_REDIS_HOST_PORT=6379

# Single Server Plus helper services bind to localhost by default so database
# and object storage admin endpoints are not reachable from remote hosts. Change
# *_HOST_BIND only if you intentionally expose the service through a
# firewall/VPN/reverse proxy.
PGBOUNCER_HOST_BIND=127.0.0.1
PGBOUNCER_HOST_PORT=6432
MINIO_API_HOST_BIND=127.0.0.1
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_BIND=127.0.0.1
MINIO_CONSOLE_HOST_PORT=9001

# API load balancer helper ports.
API_LB_TRAEFIK_WEB_HOST_PORT=8080
API_LB_TRAEFIK_DASHBOARD_HOST_PORT=8081

# ---------------------------------------------------------------------
# Backend database
# ---------------------------------------------------------------------
DATABASE_USER="postgres"
DATABASE_PASSWORD="CHANGE_ME" # REQUIRED for bundled Postgres. Auto-generated on setup; review/rotate before production.
DATABASE_HOST="localhost"
DATABASE_PORT=5432
DATABASE_NAME="omlorix"
DATABASE_SCHEMA="app"
DATABASE_AUDIT_LOG_SCHEMA="audit"
DATABASE_LOGS_SCHEMA="logs"

# Automatic PostgreSQL database creation is enabled by default. Set false when
# the target database is provisioned externally or the DB user cannot create databases.
# This does not affect Docker Compose deployments.
OMLORIX_AUTO_CREATE_DATABASES=true

# Compose-only override knobs for container-internal endpoints. The Launcher
# and CLI derive the application endpoint below: bundled PostgreSQL uses
# postgres:5432, while enabled PgBouncer uses pgbouncer:5432. Migrations keep
# the direct endpoint so bootstrap can reach PostgreSQL's control database.
DATABASE_HOST_OVERRIDE="postgres"
DATABASE_PORT_OVERRIDE=5432
DATABASE_MIGRATION_HOST_OVERRIDE="postgres"
DATABASE_MIGRATION_PORT_OVERRIDE=5432

# External PostgreSQL connection (required when OMLORIX_USE_BUNDLED_DB=false).
# Example: DATABASE_URL="postgresql://omlorix:secret@db.example.com:5432/omlorix"
DATABASE_URL=""


# ---------------------------------------------------------------------
# Redis, cache, streams, and queues
# ---------------------------------------------------------------------
REDIS_PASSWORD="CHANGE_ME" # REQUIRED for bundled Redis. Auto-generated on setup; review/rotate before production.

# External Redis connection (required when OMLORIX_USE_BUNDLED_REDIS=false).
# Example: REDIS_URL="rediss://:secret@redis.example.com:6380/0"
# If using bundled Redis (OMLORIX_USE_BUNDLED_REDIS=true), use the Docker Compose
# service hostname `redis`; the launcher auto-generates this URL from REDIS_PASSWORD.
REDIS_URL="redis://:CHANGE_ME@redis:6379/0" # REQUIRED when Redis is enabled; keep the password in sync with REDIS_PASSWORD.

# Optional deployment identifier for isolating settings-cache keys when
# multiple Omlorix deployments intentionally share Redis and a database.
SETTINGS_CACHE_NAMESPACE=""
AUTOMATION_QUEUE_NAME="omlorix-automations"
AUTOMATION_SCHEDULER_ENABLED=true

# Bound how long a Generation Worker waits for an external Research Worker to
# start a subagent and how long one nested run may occupy the parent generation.
RESEARCH_SUBAGENT_QUEUE_START_TIMEOUT_SECONDS=60
RESEARCH_SUBAGENT_COMPLETION_TIMEOUT_SECONDS=21600

# Import uploads are streamed through shared staging. PostgreSQL-backed
# reservations enforce these aggregate byte and slot ceilings across every API
# replica, including partial uploads and work waiting in the operations queue.
OPERATIONS_IMPORT_MAX_BYTES=536870912
OPERATIONS_IMPORT_STAGING_GLOBAL_MAX_BYTES=8589934592
OPERATIONS_IMPORT_STAGING_PRINCIPAL_MAX_BYTES=1073741824
OPERATIONS_IMPORT_STAGING_GLOBAL_MAX_SLOTS=1000
OPERATIONS_IMPORT_STAGING_PRINCIPAL_MAX_SLOTS=10


# ---------------------------------------------------------------------
# PgBouncer and MinIO helper services
# ---------------------------------------------------------------------
# Omlorix supports transaction and session pooling. Statement pooling cannot
# preserve the multi-statement transactions used by the application.
PGBOUNCER_POOL_MODE="transaction"
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=10

MINIO_ROOT_USER="CHANGE_ME" # REQUIRED before first run; replace with your MinIO admin username.
MINIO_ROOT_PASSWORD="CHANGE_ME" # REQUIRED before first run; replace with a strong MinIO admin password.


# ---------------------------------------------------------------------
# PostgreSQL volume layout
# ---------------------------------------------------------------------
# The named postgres_data volume is mounted here. Keep the default stable so
# upgrades do not accidentally initialize a second empty database directory.
POSTGRES_VOLUME_MOUNT_PATH=/var/lib/postgresql
POSTGRES_PGDATA=/var/lib/postgresql/18/docker


# ---------------------------------------------------------------------
# Database migration orchestration
# ---------------------------------------------------------------------
# Set to "off" for app pods/containers and run migrations in a dedicated job/service.
DB_MIGRATIONS_MODE=off

# Advisory lock wait timeout used by migration runner.
DB_MIGRATIONS_LOCK_TIMEOUT_SECONDS=120


# ---------------------------------------------------------------------
# User file storage
# ---------------------------------------------------------------------
# When OMLORIX_USE_BUNDLED_STORAGE=false, set FILE_STORAGE_PROVIDER to one of
# s3, gcs, azure, or webdav before starting external storage deployments.
FILE_STORAGE_PROVIDER=""
FILE_STORAGE_LOCAL_BASE_PATH="app/data/userFiles"

# S3-compatible storage (AWS S3 / MinIO / Cloudflare R2 / etc.)
FILE_STORAGE_S3_BUCKET=""
FILE_STORAGE_S3_PREFIX=""
FILE_STORAGE_S3_REGION=""
FILE_STORAGE_S3_ENDPOINT_URL=""
FILE_STORAGE_S3_ACCESS_KEY_ID=""
FILE_STORAGE_S3_SECRET_ACCESS_KEY=""
FILE_STORAGE_S3_SESSION_TOKEN=""

# Google Cloud Storage
FILE_STORAGE_GCS_BUCKET=""
FILE_STORAGE_GCS_PREFIX=""
FILE_STORAGE_GCS_PROJECT=""
FILE_STORAGE_GCS_CREDENTIALS_JSON=""

# Azure Blob Storage
FILE_STORAGE_AZURE_CONTAINER=""
FILE_STORAGE_AZURE_PREFIX=""
FILE_STORAGE_AZURE_CONNECTION_STRING=""
FILE_STORAGE_AZURE_ACCOUNT_URL=""
FILE_STORAGE_AZURE_CREDENTIAL=""

# WebDAV
FILE_STORAGE_WEBDAV_URL=""
FILE_STORAGE_WEBDAV_USERNAME=""
FILE_STORAGE_WEBDAV_PASSWORD=""
FILE_STORAGE_WEBDAV_PREFIX=""
FILE_STORAGE_WEBDAV_VERIFY_SSL="true"
FILE_STORAGE_WEBDAV_TIMEOUT="30"


# ---------------------------------------------------------------------
# File scanning and temporary files
# ---------------------------------------------------------------------
# Temp-file cleanup tuning (seconds)
FILE_TEMP_CLEANUP_INTERVAL_SECONDS=300
FILE_TEMP_MAX_AGE_SECONDS=3600
FILE_MATERIALIZED_TEMP_MAX_AGE_SECONDS=900


# ---------------------------------------------------------------------
# Backup and restore
# ---------------------------------------------------------------------
BACKUP_LOCAL_DIR="/app/backups"
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL_SECONDS=60
BACKUP_WRITE_FREEZE_MAX_SECONDS=300
# Bound PostgreSQL relation-lock waits and the complete restore subprocess so a
# failed restore exits cleanly instead of leaving the instance in maintenance.
BACKUP_RESTORE_LOCK_TIMEOUT_SECONDS=30
BACKUP_RESTORE_COMMAND_TIMEOUT_SECONDS=7200

# Optional path inside the backend container for the restore-resistant completed
# user-erasure ledger. Blank uses the persistent Omlorix data directory. A custom
# path must be mounted on durable storage and must not be stored only in backups.
# If placed under Omlorix's data directory, its top-level directory is reserved
# for the ledger and excluded from backup replacement as one unit.
OMLORIX_ERASURE_LEDGER_PATH=""

# BACKUP_ARCHIVE_ENCRYPTION_PASSPHRASE is REQUIRED when encryption is enabled.
# Encryption is enabled by default for backup jobs, so leaving this empty causes
# encrypted backup/restore operations to fail.
# Keep a secure copy outside the backup archive. Backup archives do not include
# environment secrets, and restoring encrypted data also requires the original
# ENCRYPTION_KEY plus any deployment-specific service credentials.
# Set a strong secret BEFORE running backup/restore, or temporarily allow
# plaintext archives via BACKUP_ALLOW_PLAINTEXT_ARCHIVES=true (disabled by default).
BACKUP_ARCHIVE_ENCRYPTION_PASSPHRASE=""

# Keep plaintext backups disabled by default.
# Set to true only for temporary compatibility scenarios.
BACKUP_ALLOW_PLAINTEXT_ARCHIVES=false


# ---------------------------------------------------------------------
# API rate limiting
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=180
RATE_LIMIT_CHAT_RPM=30
RATE_LIMIT_HEAVY_RPM=10
RATE_LIMIT_WIDGET_FRAME_RPM=120
RATE_LIMIT_AUTH_RPM=40

# Optional trusted proxy CIDRs for X-Forwarded-For parsing in rate limiter.
# Leave empty to use security.trust_proxy_headers + security.trusted_proxies from settings.
RATE_LIMIT_TRUSTED_PROXIES=""
AUTH_TRUSTED_PROXIES=""
RATE_LIMIT_PROXY_SETTINGS_CACHE_SECONDS=60


# ---------------------------------------------------------------------
# Observability host port bindings
# ---------------------------------------------------------------------
# Observability endpoints bind to localhost by default. Keep collector
# ingestion, Jaeger, Prometheus, and Grafana behind trusted local access unless
# you add authentication and network controls such as a VPN or reverse proxy.
OTEL_GRPC_HOST_BIND=127.0.0.1
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_BIND=127.0.0.1
OTEL_HTTP_HOST_PORT=4318
OTEL_PROMETHEUS_HOST_BIND=127.0.0.1
OTEL_PROMETHEUS_HOST_PORT=8889
OTEL_HEALTHCHECK_HOST_BIND=127.0.0.1
OTEL_HEALTHCHECK_HOST_PORT=13133
JAEGER_UI_HOST_BIND=127.0.0.1
JAEGER_UI_HOST_PORT=16686
JAEGER_COLLECTOR_HOST_BIND=127.0.0.1
JAEGER_COLLECTOR_HOST_PORT=14268
PROMETHEUS_HOST_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_BIND=127.0.0.1
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_BIND=127.0.0.1
GRAFANA_HOST_PORT=3001


# ---------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------
# Enable/disable OpenTelemetry instrumentation (disabled by default).
OTEL_ENABLED=false

# Service identification.
OTEL_SERVICE_NAME="omlorix-backend"

# OTLP exporter endpoint. Secure by default; the observability Compose overlay
# explicitly overrides this for its bundled plaintext collector.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector:4317"
OTEL_EXPORTER_OTLP_INSECURE=false

# Tracing configuration.
OTEL_TRACES_ENABLED=true

# Sampling strategy: always_on, always_off, traceidratio, parentbased_traceidratio
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="1.0"

# Metrics and logs.
OTEL_METRICS_ENABLED=true
OTEL_PROMETHEUS_EXPORTER_ENABLED=true
OTEL_LOGS_ENABLED=true

# Instrumentation scope.
OTEL_INSTRUMENT_FASTAPI=true
OTEL_INSTRUMENT_SQLALCHEMY=true
OTEL_INSTRUMENT_HTTP_CLIENTS=true
OTEL_SQL_COMMENTER_ENABLED=false

# Privacy-sensitive attribute capture controls.
OTEL_CAPTURE_HTTP_ROUTE=false
OTEL_CAPTURE_HTTP_USER_AGENT=false
OTEL_HASH_HTTP_USER_AGENT=true


# ---------------------------------------------------------------------
# Grafana and exporter overrides
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER="CHANGE_ME" # REQUIRED when observability is enabled. Replace with a non-default username.
GRAFANA_ADMIN_PASSWORD="CHANGE_ME" # REQUIRED when observability is enabled. Replace with a secure password.
# GRAFANA_ROOT_URL="http://localhost:3001"

# Optional exporter connection overrides for external database/cache deployments.
# POSTGRES_EXPORTER_DATA_SOURCE_URI="postgres:5432/omlorix?sslmode=disable"
# POSTGRES_EXPORTER_DATA_SOURCE_USER="postgres"
# POSTGRES_EXPORTER_DATA_SOURCE_PASS="CHANGE_ME"
# REDIS_EXPORTER_ADDR="redis://redis:6379"
